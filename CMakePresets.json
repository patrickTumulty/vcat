{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "x86",
            "inherits": "base",
            "displayName": "x86 (host architecture)"
        },
        {
            "name": "arm64",
            "inherits": "base",
            "displayName": "Cross compile for aarch64",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x86",
            "configurePreset": "x86"
        },
        {
            "name": "arm64",
            "configurePreset": "arm64"
        }
    ]
}
